{
  "name": "@ningtian-byte/dsh-tokendashboard",
  "version": "1.0.0",
  "type": "module",
  "description": "A local-first token usage and API call dashboard for DeepSeek Harness",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "usage.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "docs/images/*.png",
    "docs/PUBLISHING.md"
  ],
  "scripts": {
    "check": "node --check index.js && node --check usage.js && node --check client.js",
    "prepublishOnly": "npm run check"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "token-monitor",
    "token-usage",
    "api-calls",
    "cache",
    "dsh-plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NingTiAn-byte/DSH-TokenDashboard.git"
  },
  "homepage": "https://github.com/NingTiAn-byte/DSH-TokenDashboard#readme",
  "bugs": {
    "url": "https://github.com/NingTiAn-byte/DSH-TokenDashboard/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
